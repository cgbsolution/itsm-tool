# Production settings for docker compose. Copy to .env and fill in.
APP_URL=https://itsm.example.local
# Password of the bundled PostgreSQL (long, random)
POSTGRES_PASSWORD=
# 32+ random characters; back it up: it decrypts MFA and integration secrets
APP_SECRET=
PRODUCT_NAME=ITSM Suite
MIGRATE_ON_START=true
WORKER_ENABLED=true
LOG_LEVEL=info
# Where the app port listens on the host (keep 127.0.0.1 when using the tls proxy profile)
APP_BIND=127.0.0.1

# Outgoing email (tenants can override in Admin > Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# With the "av" profile: CLAMAV_ADDRESS=clamav:3310
CLAMAV_ADDRESS=

# First start only: creates the first tenant and a super admin (must change password at first sign-in)
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
