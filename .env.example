# Copy to .env and fill in. Every value here is an example.

# Public URL people use to reach the app (used in emails, agent install commands, OIDC callbacks)
APP_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://itsm:itsm_dev_password@localhost:5544/itsm

# 32+ random characters. Encrypts MFA secrets and stored integration passwords.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-value

# Product name shown when a tenant has no brand name
PRODUCT_NAME=ITSM Suite

# Where uploaded files are stored (attachments, KB images, offline patch packages)
STORAGE_DIR=./data/files

# Run pending database migrations when the app starts (recommended for single-node installs)
MIGRATE_ON_START=true
# Run the background worker (SLA checks, email, scheduled jobs) inside the app process
WORKER_ENABLED=true

# Default SMTP (each tenant can override in Admin > Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional ClamAV daemon for attachment scanning (host:port)
CLAMAV_ADDRESS=

# Offline licence: path to the vendor public key (PEM). Without it the app runs in evaluation mode.
LICENSE_PUBLIC_KEY_FILE=./keys/license-public.pem

# Log level: debug | info | warn | error
LOG_LEVEL=info

# First start only: creates the first tenant and super admin if the database is empty
BOOTSTRAP_TENANT_NAME=Default
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
